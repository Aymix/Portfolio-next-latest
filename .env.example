# PostHog analytics (free tier)
# 1. Sign up at https://posthog.com (free: 1M events/month)
# 2. Project Settings -> copy your Project API Key (starts with "phc_")
# 3. Copy this file to .env.local and fill in the key below
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# US cloud: https://us.i.posthog.com  |  EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
